# 【v0.6.52 装杯改成"等点击才退场"】玩家 2026-09-12 定稿, 原话:
#   「当弹珠落入容器后，界面不再消失，当玩家手动点击屏幕任意位置的时候才消失。
#     当弹珠没有下落完成+0.6秒后，点击也不消失。」
#
#   ① **装满后不再自动退场** —— 画面停在装满状态, 等玩家点屏幕任意位置才收走。退场起点
#      从 `_settled_at + _hold` 改成**玩家点击那一刻**(`_closing_at`)。
#   ② **最短停留 0.6s**: 最后一颗球落定 + 0.6s 之前点击无效(球还在往下落时 mode 还不是
#      result, 同样不受理)。判据全在 `request_close()` 里。
#   ③ 停留时长**统一 0.6**(不再按倍率分档) —— `HOLD_TIERS` / `HOLD_STEP` 已删,
#      `hold_for(m)` 恒返回 HOLD_BASE。签名不改: 5 个消费者 + 6 条探针判据都写它。
#   ④ 一直不点就一直停着。
#   ⑤ 彩蛋路径**同样等点击**(规则单一, 玩家不用记两套)。
#   ⑥ **跑分例外**: 跑分是自动连续发射的, 等人点击会把整轮跑分卡死 —— 那一路仍到点自己走。
#      用显式参数 `play_win(..., auto_close=...)` 从界面传下去, 不让演出自己去猜界面状态。
#
#   ⚠️ `FX_MAX_SEC` 9.0 -> 60.0: 退场改成等点击之后, 9 秒对"看够了再点"太短, 会把画面
#      **当场清掉**(`_abort` 是 mode=idle + 清空球)。它是**安全网**不是产品行为 —— 防的是
#      "某个 bug 让点击失效 -> 真卡死"; 触发时画面会突然没了, 跟"一直等"矛盾, 两害相权
#      宁可画面没了也不能锁死玩家。
#   ⚠️ `_layers()` 的退场分支多了个前置: 没收到关闭请求时**恒返回装满静止态** `(1,1,1,0)`
#      —— dy 必须是 0, 否则整组会停在"上浮过的"位置(那是退场终态的姿势, 不是装满的)。
#
#   门禁:
#     · [5] "七档停留严格递增" 改成 "**七档停留一致**"(分档已废, 改回递增 = 又加回来了)
#     · [6] 夹具改成设 `_closing_at`; 新增"没点击时恒返回装满静止态"
#     · [10]/[11] 的 tick 循环**必须模拟点击**才回得到 idle; 上界也重算 —— 按 FX_MAX_SEC
#       (60s) 算跑不完, 而按"停留+淡出"算**又太短**(实测 x100 的揭晓在 _t0+2.9s, 2.85s
#       的窗口根本放不出来, 会误报"丢账")
#     · 新增 **[20] 等玩家点击**: 20a 装满后不自动退场 / 20b 最短停留 / 20c 点击后走现成的
#       0.25s 淡出曲线 / 20d 跑分例外
#   **四条阴性对照都实做了**(把改动分别改回坏的样子, 实测全红):
#     20a 改回自动退场 -> 12s 后 mode=idle
#     20b 去掉最短停留 -> 早 0.05s 的点击被受理
#     20c 去掉"等待期返回静止态" -> 等待期被渲染成退场终态 (0.0, 0.0, 0.9, 52.0)
#     20d 摘掉跑分例外 -> auto_close 之后 0.85s 仍停在 result
#   四道门禁全绿(--check / fx_probe / --selftest / --smoke)。
version = 0.6.52




requirements = python3,kivy==2.3.0,pyjnius

# 锁定 python-for-android 到 2024 年的 tag,绕开新版默认下载 Python 3.14 alpha 的问题
p4a.branch = v2024.01.21
# 构建后 hook: 往 manifest 主 activity 强制 screenOrientation=fullSensor + resizeableActivity=true
p4a.hook = p4a/hook.py

# 四方向随重力: 正竖/倒竖180°/横拿全支持。横拿时 app 内切左盘面+右控制列分栏(盘面竖直满屏),
# 不再锁竖屏——锁竖屏会被 12L+ 大屏 letterbox/ZUI 关进半屏兼容盒(画面缩小的病根)
orientation = portrait, portrait-reverse, landscape, landscape-reverse
# 显式 manifest 方向: fullSensor(四方向随重力, Android原生值), 与 hook 注入一致
android.manifest.orientation = fullSensor
# 全屏沉浸(仅运行时实现): 状态栏/导航栏由 main.py _enter_immersive() 负责隐藏。
# fullscreen 保持=0(与已知可跑的 0.5.0 一致, 不折腾): 0.5.1(fullscreen=1)与
# 0.5.2(=0)当时都闪退, 但真凶是 _enter_immersive 的零参签名 bug(见 BUILD_APK.md
# 弯路 3.22), fullscreen=1 本身未被证明有问题, 只是也没必要开。
fullscreen = 0

android.permissions = VIBRATE

# targetSdk=33(2026-08-17): 30 的兼容模式在 12L+ 大屏(sw>=600dp)会被塞固定比例
# letterbox 盒(ZUI 近正方形半屏盒, 实测 fullSensor 四方向也躲不开, 像素取证确认)。
# 33+ 声明全方向+resizeable 才给全屏窗口; 锁竖屏时代(sensorPortrait 需兼容模式)已结束。
android.api = 33
android.minapi = 21
android.ndk = 25b

android.archs = arm64-v8a,armeabi-v7a

android.allow_backup = True

icon.filename = %(source.dir)s/icon.png

# 必须和 presplash.png 边缘同色(#0b1220),避免闪屏黑闪
android.presplash_color = #0b1220
presplash.filename = %(source.dir)s/presplash.png


[buildozer]

log_level = 2
warn_on_root = 1
